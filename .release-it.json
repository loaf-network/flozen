{
  "git": {
    "commitMessage": "release: v${version}",
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": false
  },
  "hooks": {
    "after:bump": "node -e \"const fs=require('fs');const f='src-tauri/Cargo.toml';let c=fs.readFileSync(f,'utf8');c=c.replace(/^version = \\\"[^\\\"]*\\\"/m,'version = \\\"${version}\\\"');fs.writeFileSync(f,c)\""
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md"
    }
  }
}
